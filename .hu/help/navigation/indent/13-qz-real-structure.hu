{
  "desc": "q and z navigate a realistic indented structure",
  "before": [
    "def main():",
    "  if True:",
    "    x = 1",
    "    y = 2",
    "  else:",
    "    z = 3",
    "  return x"
  ],
  "frames": [
    {
      "desc": "navigate to y = 2",
      "keys": ["j", "j", "j"],
      "cursor": [3, 0]
    },
    {
      "desc": "q finds if True: (indent 2)",
      "keys": ["q"],
      "cursor": [1, 2]
    },
    {
      "desc": "q finds def main(): (indent 0)",
      "keys": ["q"],
      "cursor": [0, 0]
    },
    {
      "desc": "z finds nothing less-indented below (all indented more)",
      "keys": ["z"],
      "cursor": [0, 0]
    }
  ]
}
