# Local dev setup for the .commit.sh / .run.sh / .doctest.sh wrappers.
# Copy to .env and edit. .env is gitignored.

# Shared tmux session that hosts each ship's dojo window. Each ship's
# tmux target is "${OXAL_TMUX_SESSION}:${ship}" — i.e. the alias below
# is also the tmux window name.
OXAL_TMUX_SESSION=oxal

# Space-separated list of ship aliases (also tmux window names). The
# wrappers fan their command out to every ship listed here, in
# parallel, and print labeled output blocks in declared order.
OXAL_SHIPS="ship"

# Per-ship rsync spec for source sync, formatted as <src>:<dest>.
# <src> is relative to the repo root (use "." for the whole tree, or
# a subdir like "lodge"). <dest> is the rsync target; relative paths
# are resolved against the repo root.
# .commit.sh runs this sync, then issues |commit %oxal.
OXAL_ship_SYNC=.:.piers/master-migrev-dolseg/oxal

# Example second ship:
# OXAL_SHIPS="ship secondary"
# OXAL_secondary_SYNC=.:.piers/secondary/oxal

# Example syncing only a subdir into a sub-path of the desk:
# OXAL_ship_SYNC=lodge:.piers/master-migrev-dolseg/oxal/lodge

# Default dojo command timeout in seconds (shared across ships).
OXAL_TIMEOUT=150
