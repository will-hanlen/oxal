# Local dev setup for the .commit.sh / .run.sh / .doctest.sh wrappers.
# Copy to .env and edit. .env is gitignored.

# tmux target (session:window) where the dev ship's dojo is attached.
OXAL_TMUX_TARGET=oxal:ship

# Path to the dev pier's %oxal desk, relative to the repo root.
# .commit.sh rsyncs the source tree here before issuing |commit %oxal.
OXAL_PIER=.piers/master-migrev-dolseg/oxal

# Default dojo command timeout in seconds.
OXAL_TIMEOUT=150
